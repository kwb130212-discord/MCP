# Supabase project
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side Postgres connection. For Render, use Supabase Session Pooler (IPv4) and keep the password only in Render/local secrets.
SUPABASE_DB_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:PASSWORD@YOUR_POOLER_HOST:5432/postgres
# Legacy compatibility; prefer SUPABASE_DB_URL.
DATABASE_URL=

# Render web service
PORT=10000
PYTHONUNBUFFERED=1

# Admin bootstrap
ADMIN_USERNAME=지헌아사랑한다임마
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...
# Optional first-deploy/reset bootstrap. If used, remove it after ADMIN_PASSWORD_HASH is populated.
ADMIN_PASSWORD=

# MCP endpoint
MCP_TOKEN=
MCP_ALLOWED_HOSTS=cathero.64bit.kr,cathero.64bit.kr:443
MCP_ALLOWED_ORIGINS=https://cathero.64bit.kr

# Encrypted Cat Hero account storage
# Generate once and keep unchanged after accounts are stored.
GAME_ACCOUNT_KEY=
UPLOAD_DIR=./uploads

# Macro policy
# Support codes are macro licenses. Only staff accounts can issue/revoke them.
# License holders can only access their own supporter-scoped account/macro data.
